# Copy this file to ".env" (same folder as manage.py) and edit the values.
DJANGO_SECRET_KEY=change-this-to-any-long-random-text
DJANGO_DEBUG=1

# PostgreSQL (create the database first - see README)
DB_NAME=multimedia_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432

# Only if PostgreSQL gives you trouble and you want to test quickly, remove the "#" below.
# (For the final submission use PostgreSQL.)
# USE_SQLITE=1

# Only change if ffmpeg is not in your PATH
FFMPEG_PATH=ffmpeg
